        { "key": "f_tier_name", "label": "Tier name", "name": "name", "type": "text" },
        { "key": "f_tier_price", "label": "Price", "name": "price", "type": "text", "default_value": "Free" },
        { "key": "f_tier_features", "label": "Features", "name": "features", "type": "textarea", "rows": 5, "instructions": "One feature per line." },
        { "key": "f_tier_btn", "label": "Button text", "name": "button_text", "type": "text" },
        { "key": "f_tier_link", "label": "Button link", "name": "button_link", "type": "url" }
      ]},

      { "key": "f_sub_why_tab", "label": "Why Support ARR", "name": "", "type": "tab" },
      { "key": "f_why_heading", "label": "Section heading", "name": "why_heading", "type": "text", "default_value": "Why Support ARR" },
      { "key": "f_why_items", "label": "Why items", "name": "why_items", "type": "repeater", "layout": "block", "button_label": "Add item", "sub_fields": [
        { "key": "f_why_icon", "label": "Icon", "name": "icon", "type": "image", "return_format": "url", "preview_size": "thumbnail", "instructions": "Upload an icon, or leave blank to use the built-in one." },
        { "key": "f_why_title", "label": "Title", "name": "title", "type": "text" },
        { "key": "f_why_text", "label": "Text", "name": "text", "type": "textarea", "rows": 2 }
      ]}
    ],
    "location": [[{ "param": "page_template", "operator": "==", "value": "template-subscribe.php" }]],
    "menu_order": 0, "position": "normal", "style": "default",
    "label_placement": "top", "instruction_placement": "label",
    "hide_on_screen": "", "active": true,
    "description": "All editable content on the Subscribe page."
  },

