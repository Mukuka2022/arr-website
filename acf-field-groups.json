      { "key": "f_sub_headline", "label": "Headline", "name": "sub_headline", "type": "text", "default_value": "A curated briefing of ideas that matter — every Saturday." },
      { "key": "f_sub_dek", "label": "Subtext", "name": "sub_dek", "type": "textarea", "rows": 3, "default_value": "Join policymakers, executives, and scholars who start their weekend with ARR's take on the analysis shaping Africa's next chapter." },
      { "key": "f_sub_stats", "label": "Stat box rows", "name": "sub_stats", "type": "repeater", "layout": "table", "button_label": "Add stat", "sub_fields": [
