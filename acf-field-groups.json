        { "key": "f_stat_value", "label": "Value", "name": "value", "type": "text" }
      ]},

      { "key": "f_sub_tiers_tab", "label": "Membership", "name": "", "type": "tab" },
      { "key": "f_mem_eyebrow", "label": "Eyebrow", "name": "mem_eyebrow", "type": "text", "default_value": "Membership" },
      { "key": "f_mem_heading", "label": "Heading", "name": "mem_heading", "type": "text", "default_value": "Join ARR — free, always" },
      { "key": "f_mem_sub", "label": "Subtext", "name": "mem_sub", "type": "textarea", "rows": 2, "default_value": "Create a free account to save articles, join the discussion, and get the weekly brief straight to your inbox." },
      { "key": "f_tiers", "label": "Tier cards", "name": "tiers", "type": "repeater", "layout": "block", "button_label": "Add tier", "sub_fields": [
