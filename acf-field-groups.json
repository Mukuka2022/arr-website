[
  {
    "key": "group_arr_home",
    "title": "Homepage Content",
    "fields": [
      { "key": "f_hero_tab", "label": "Hero Banner", "name": "", "type": "tab" },
      { "key": "f_hero_eyebrow", "label": "Eyebrow label", "name": "hero_eyebrow", "type": "text", "default_value": "Editor's Pick" },
      { "key": "f_hero_headline", "label": "Headline", "name": "hero_headline", "type": "text", "default_value": "Africa's Future Will Be Built on Knowledge, Not Raw Materials" },
      { "key": "f_hero_dek", "label": "Subtext", "name": "hero_dek", "type": "textarea", "rows": 3, "default_value": "The continent's next leap will come from innovation, skills, institutions, and ideas that solve our own problems." },
      { "key": "f_hero_btn_text", "label": "Button text", "name": "hero_button_text", "type": "text", "default_value": "Read the Editorial" },
      { "key": "f_hero_btn_link", "label": "Button link", "name": "hero_button_link", "type": "url" },
      { "key": "f_hero_image", "label": "Background image", "name": "hero_image", "type": "image", "return_format": "url", "preview_size": "medium", "instructions": "Wide landscape photo, at least 1400px across." },

      { "key": "f_cats_tab", "label": "Category Strip", "name": "", "type": "tab" },
      { "key": "f_cat_items", "label": "Category cards", "name": "category_items", "type": "repeater", "layout": "block", "button_label": "Add category card", "min": 0, "max": 8, "instructions": "The six icon cards below the hero. Leave empty to auto-generate from your WordPress categories.", "sub_fields": [
        { "key": "f_cat_icon", "label": "Icon", "name": "icon", "type": "image", "return_format": "url", "preview_size": "thumbnail", "instructions": "Upload an SVG or PNG icon. Leave blank to use the built-in line icon." },
        { "key": "f_cat_title", "label": "Title", "name": "title", "type": "text" },
        { "key": "f_cat_desc", "label": "Description", "name": "description", "type": "textarea", "rows": 2 },
        { "key": "f_cat_link", "label": "Link", "name": "link", "type": "url" }
      ]},

      { "key": "f_sections_tab", "label": "Section Headings", "name": "", "type": "tab" },
      { "key": "f_authors_heading", "label": "Featured Authors heading", "name": "authors_heading", "type": "text", "default_value": "Featured Authors" },
      { "key": "f_longread_heading", "label": "Long Read heading", "name": "longread_heading", "type": "text", "default_value": "Long Read" },
      { "key": "f_trending_heading", "label": "Trending Ideas heading", "name": "trending_heading", "type": "text", "default_value": "Trending Ideas" },

      { "key": "f_cta_tab", "label": "Bottom CTA Band", "name": "", "type": "tab" },
      { "key": "f_podcast_title", "label": "Podcast title", "name": "podcast_title", "type": "text", "default_value": "Listen to Our Podcast" },
      { "key": "f_podcast_text", "label": "Podcast text", "name": "podcast_text", "type": "textarea", "rows": 2, "default_value": "Conversations with Africa's thinkers, leaders, and builders." },
      { "key": "f_podcast_link", "label": "Podcast link", "name": "podcast_link", "type": "url" },
      { "key": "f_brief_title", "label": "Newsletter title", "name": "brief_title", "type": "text", "default_value": "Weekly Brief" },
      { "key": "f_brief_text", "label": "Newsletter text", "name": "brief_text", "type": "textarea", "rows": 2, "default_value": "A curated briefing of ideas that matter. Every Saturday." },
      { "key": "f_reports_title", "label": "Reports title", "name": "reports_title", "type": "text", "default_value": "Special Reports" },
      { "key": "f_reports_text", "label": "Reports text", "name": "reports_text", "type": "textarea", "rows": 2, "default_value": "In-depth reports on Africa's most critical issues." },
      { "key": "f_reports_link", "label": "Reports link", "name": "reports_link", "type": "url" }
    ],
    "location": [[{ "param": "page_type", "operator": "==", "value": "front_page" }]],
    "menu_order": 0, "position": "normal", "style": "default",
    "label_placement": "top", "instruction_placement": "label",
    "hide_on_screen": "", "active": true,
    "description": "All editable content on the homepage."
  },

  {
    "key": "group_arr_about",
    "title": "About Page Content",
    "fields": [
      { "key": "f_ab_banner_tab", "label": "Page Banner", "name": "", "type": "tab" },
      { "key": "f_ab_eyebrow", "label": "Eyebrow", "name": "about_eyebrow", "type": "text", "default_value": "About ARR" },
      { "key": "f_ab_title", "label": "Banner headline", "name": "about_title", "type": "text", "default_value": "An institution built on the conviction that ideas transform civilizations" },
      { "key": "f_ab_subtitle", "label": "Banner subtext", "name": "about_subtitle", "type": "textarea", "rows": 2, "default_value": "Ideas. Evidence. Wisdom. Africa. — the four words that discipline everything we publish." },

      { "key": "f_ab_vm_tab", "label": "Vision & Mission", "name": "", "type": "tab" },
      { "key": "f_vision_text", "label": "Vision statement", "name": "vision_text", "type": "textarea", "rows": 4, "default_value": "To become Africa's most trusted independent institution for ideas, scholarship, and public discourse — advancing an intellectual renaissance that shapes ethical leadership, resilient institutions, technological innovation, and sustainable development." },
      { "key": "f_vision_note", "label": "Vision note", "name": "vision_note", "type": "text", "default_value": "Trust is more valuable than popularity. Influence is more enduring than visibility." },
      { "key": "f_mission_text", "label": "Mission statement", "name": "mission_text", "type": "textarea", "rows": 4, "default_value": "To cultivate rigorous analysis, independent thought, and evidence-based dialogue that strengthens Africa's intellectual life, informs public policy, and equips society to address the defining challenges of the 21st century." },
      { "key": "f_mission_note", "label": "Mission note", "name": "mission_note", "type": "text", "default_value": "Every article should educate. Every publication should illuminate. Every debate should elevate." },

      { "key": "f_ab_story_tab", "label": "The ARR Story", "name": "", "type": "tab" },
      { "key": "f_story_heading", "label": "Section heading", "name": "story_heading", "type": "text", "default_value": "The ARR Story" },
      { "key": "f_story_steps", "label": "Story steps", "name": "story_steps", "type": "repeater", "layout": "block", "button_label": "Add step", "sub_fields": [
        { "key": "f_story_title", "label": "Title", "name": "title", "type": "text" },
        { "key": "f_story_text", "label": "Text", "name": "text", "type": "textarea", "rows": 3 }
      ]},

      { "key": "f_ab_pillars_tab", "label": "Editorial Pillars", "name": "", "type": "tab" },
      { "key": "f_pillars_heading", "label": "Section heading", "name": "pillars_heading", "type": "text", "default_value": "Editorial Pillars" },
      { "key": "f_pillars_sub", "label": "Section subtext", "name": "pillars_sub", "type": "text", "default_value": "Seven pillars define the intellectual identity of ARR" },
      { "key": "f_pillars", "label": "Pillars", "name": "pillars", "type": "repeater", "layout": "table", "button_label": "Add pillar", "sub_fields": [
        { "key": "f_pillar_title", "label": "Pillar name", "name": "title", "type": "text" }
      ]},

      { "key": "f_ab_values_tab", "label": "What We Stand For", "name": "", "type": "tab" },
      { "key": "f_values_heading", "label": "Section heading", "name": "values_heading", "type": "text", "default_value": "What We Stand For" },
      { "key": "f_values_sub", "label": "Section subtext", "name": "values_sub", "type": "text", "default_value": "Our Core Values" },
      { "key": "f_values", "label": "Values", "name": "values", "type": "repeater", "layout": "block", "button_label": "Add value", "sub_fields": [
        { "key": "f_value_title", "label": "Title", "name": "title", "type": "text" },
        { "key": "f_value_text", "label": "Description", "name": "text", "type": "textarea", "rows": 2 }
      ]}
    ],
    "location": [[{ "param": "page_template", "operator": "==", "value": "template-about.php" }]],
    "menu_order": 0, "position": "normal", "style": "default",
    "label_placement": "top", "instruction_placement": "label",
    "hide_on_screen": "", "active": true,
    "description": "All editable content on the About page."
  },

  {
    "key": "group_arr_subscribe",
    "title": "Subscribe Page Content",
    "fields": [
      { "key": "f_sub_hero_tab", "label": "Hero", "name": "", "type": "tab" },
